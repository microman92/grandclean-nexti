6:[["$","$L12",null,{"lang":"ru","t":{"meta":{"siteName":"GrandClean","siteUrl":"https://grandclean.uz","defaultTitle":"GrandClean — Профессиональный клининг в Ташкенте","defaultDescription":"GrandClean — лучший клининг в Ташкенте. Химчистка мебели и ковров, услуги уборки квартир, офисов, домов. Цены от 15 000 сум. Вызов за 2-4 часа. ☎ +998 93 571 21 51","defaultKeywords":"клининг Ташкент, уборка квартир Ташкент, химчистка мебели Ташкент, стирка ковров Ташкент, мойка окон Ташкент, GrandClean"},"nav":{"home":"Главная","services":"Услуги","about":"О компании","pricing":"Цены","reviews":"Отзывы","contact":"Контакты","order":"Заказать уборку","langSwitch":"O'zbek"},"hero":{"badge":"Премиум клининг в Ташкенте","h1":"Профессиональная уборка помещений в Ташкенте","title":"Безупречная","titleAccent":"чистота","titleEnd":"вашего пространства","subtitle":"Профессиональная химчистка мебели, стирка ковров и уборка квартир в Ташкенте. Используем оборудование Karcher и безопасные эко-средства.","cta":"Заказать уборку","ctaSecondary":"Узнать стоимость","stat1Value":"1000+","stat1Label":"Довольных клиентов","stat2Value":"5+","stat2Label":"Лет на рынке","stat3Value":"99%","stat3Label":"Рекомендуют нас"},"services":{"label":"Наши услуги","title":"Полный спектр клининговых услуг","description":"Мы предлагаем широкий выбор услуг по уборке для дома и бизнеса","allBtn":"Все услуги","detailBtn":"Узнать подробнее","pageTitle":"Клининговые услуги в Ташкенте","pageSubtitle":"Услуги","pageDesc":"Широкий спектр клининговых услуг для вашего дома и бизнеса","ctaTitle":"Не нашли нужную услугу?","ctaDesc":"Свяжитесь с нами и мы подберём индивидуальное решение для вас","ctaBtn":"Связаться с нами","cats":{"all":"Все","rooms":"Помещения","special":"Специальные","facades":"Фасады и экстерьер"},"includes":"Что входит","orderBtn":"Заказать услугу","detailPageBtn":"Подробнее об услуге","leaveRequest":"Оставить заявку","backBtn":"Назад ко всем услугам","aboutService":"О сервисе","startingPrice":"Начальная стоимость"},"promotions":{"label":"Акции","title":"Спецпредложения и Акции","description":"Воспользуйтесь нашими специальными предложениями для максимальной выгоды"},"advantages":{"label":"Преимущества","title":"Почему выбирают нас","description":"Мы не просто убираем — мы создаём атмосферу чистоты и комфорта","items":[{"title":"Качество","desc":"Наши профессионалы используют современные методы и экологически чистые средства, чтобы добиться безупречного результата."},{"title":"Безопасность","desc":"Мы ценим здоровье вас и ваших близких. Поэтому мы используем только безопасные химические компоненты, которые не представляют угрозу."},{"title":"Подход к каждому","desc":"Мы работаем с каждым клиентом индивидуально, учитывая все ваши пожелания и требования."},{"title":"Скорость","desc":"Мы ценим ваше время. Поэтому мы выполняем наши работы быстро и эффективно, чтобы вы могли наслаждаться чистотой как можно скорее."},{"title":"Цены","desc":"Наше качество доступно. Мы предлагаем конкурентоспособные цены, а также скидки для наших постоянных клиентов."},{"title":"Удобство","desc":"Мы заботимся о вашем комфорте. У нас есть удобная система заказов, гибкое расписание и доставка мебели/ковров."}]},"howItWorks":{"label":"Как мы работаем","title":"Наш процесс — залог чистоты","description":"5 этапов идеального клининга вашего помещения","steps":[{"num":"01","title":"Подготовка помещения","desc":"Осмотр объекта и подбор специализированной химии"},{"num":"02","title":"Основная чистка","desc":"Глубокое очищение поверхностей и материалов"},{"num":"03","title":"Удаление пятен","desc":"Точечная работа со сложными загрязнениями"},{"num":"04","title":"Дезинфекция","desc":"Обработка и сушка очищенных зон"},{"num":"05","title":"Проверка качества","desc":"Финальный осмотр и сдача работы клиенту"}]},"beforeAfter":{"label":"Результаты","title":"Разница очевидна","description":"Посмотрите на результаты нашей работы в формате 'До / После'"},"faq":{"label":"Вопросы и ответы","title":"Часто задаваемые вопросы (FAQ)","description":"Отвечаем на самые популярные вопросы о нашем сервисе","serviceFaqTitle":"FAQ —","serviceFaqDesc":"Ответы на самые частые вопросы об этой услуге","items":[{"question":"Как быстро приедет бригада после оформления заявки?","answer":"В среднем мы выезжаем в течение 2–4 часов в любой район Ташкента. Для генеральной уборки рекомендуем бронировать дату за 1–2 дня."},{"question":"Вы работаете в Ташкентской области (Чирчик, Янгиюль, Кибрай)?","answer":"Да, мы выезжаем за пределы ТКАД. До 10 км от города выезд бесплатный, далее — по согласованию в зависимости от объема услуг."},{"question":"Нужно ли мне находиться дома во время уборки?","answer":"Необязательно. Многие наши клиенты передают ключи и занимаются своими делами. Мы несем полную материальную ответственность за сохранность вещей."},{"question":"Безопасны ли ваши чистящие средства для детей и животных?","answer":"Да, мы используем только гипоаллергенные, сертифицированные эко-средства (в том числе от Karcher и Chemspec), которые абсолютно безопасны для здоровья."},{"question":"Как можно оплатить услуги (Payme, Click, наличные)?","answer":"Мы принимаем оплату любым удобным способом: наличными, через терминал, а также переводами через системы Click и Payme. Для юрлиц возможна оплата перечислением с предоставлением всех закрывающих документов."},{"question":"Что если мне не понравится качество уборки?","answer":"Мы работаем до результата. Если вы обнаружите недочеты в течение 24 часов, мы отправим клинера для бесплатного исправления или вернем часть средств."},{"question":"Как долго сохнет мебель после химчистки?","answer":"Обычно мягкая мебель полностью высыхает за 4-6 часов в теплом проветриваемом помещении. Мы используем профессиональное оборудование для вытягивания влаги."}]},"pricing":{"label":"Прайс-лист","title":"Прозрачные цены на клининг","description":"Цены на наши услуги без скрытых платежей","pageTitle":"Цены на клининг в Ташкенте","pageSubtitle":"Прайс-лист","pageDesc":"Прозрачные цены на все виды клинингового сервиса","orderBtn":"Рассчитать стоимость","note":"* Точная стоимость рассчитывается после оценки объёма работ. Выезд менеджера для замера — бесплатно.","ctaTitle":"Получите точный расчёт стоимости","ctaDesc":"Оставьте заявку и наш менеджер свяжется с вами в течение 15 минут","ctaBtn":"Заказать расчёт"},"reviews":{"label":"Отзывы","title":"Что говорят клиенты","description":"Более 1000 довольных клиентов доверяют GrandClean","pageTitle":"Отзывы клиентов","pageSubtitle":"Отзывы","pageDesc":"Мнения наших клиентов о качестве наших услуг","ctaTitle":"Стали нашим клиентом?","ctaDesc":"Поделитесь своим опытом в Google — это помогает нам становиться лучше"},"about":{"label":"О компании","title":"GrandClean — ваш надёжный партнёр в чистоте","pageTitle":"О компании","pageSubtitle":"О нас","pageDesc":"Узнайте больше о команде GrandClean и наших ценностях","story":"История компании","storyText":"GrandClean основана в 2019 году командой энтузиастов, которые верили, что клининг может быть не просто чистым — он должен быть безопасным, экологичным и выполненным с душой. За 5 лет мы выросли из маленькой бригады в ведущую клининговую компанию Ташкента с более чем 100 специалистами в штате.","mission":"Наша миссия","missionText":"Создавать идеально чистые пространства для жизни и работы, используя только безопасные материалы и передовые технологии, при этом делая сервис доступным для каждой семьи в Ташкенте.","team":"Наша команда"},"contact":{"label":"Контакты","title":"Свяжитесь с нами","pageTitle":"Контакты GrandClean в Ташкенте","h1":"Контакты GrandClean в Ташкенте","pageSubtitle":"Контакты","pageDesc":"Позвоните нам или оставьте заявку — перезвоним в течение 15 минут","subtitle":"Оставьте заявку и мы перезвоним в течение 15 минут","infoTitle":"Контактная информация","phone":"Телефон","email":"Email","address":"Адрес","workHours":"Режим работы","workHoursValue":"Пн-Вс: 08:00 — 22:00","addressValue":"Ташкент, ул. Жураева, 48","serviceOptions":