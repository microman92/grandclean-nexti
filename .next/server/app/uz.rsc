6:[["$","$Lf",null,{"lang":"uz","t":{"meta":{"siteName":"GrandClean","siteUrl":"https://grandclean.uz","defaultTitle":"GrandClean — Toshkentda professional klining","defaultDescription":"GrandClean — Toshkentning eng yaxshi klining kompaniyasi. Mebel va gilam kimyoviy tozalash, kvartira, ofis va uy tozalash xizmatlari. Narxlar 15 000 so'mdan. ☎ +998 93 571 21 51","defaultKeywords":"klining Toshkent, kvartira tozalash Toshkent, mebel kimyoviy tozalash Toshkent, gilam yuvish Toshkent, GrandClean"},"nav":{"home":"Bosh sahifa","services":"Xizmatlar","about":"Kompaniya haqida","pricing":"Narxlar","reviews":"Sharhlar","contact":"Aloqa","order":"Tozalashni buyurtma qiling","langSwitch":"Русский"},"hero":{"badge":"Toshkentda premium klining","h1":"Toshkentda professional xonalarni tozalash","title":"Fazongizning","titleAccent":"mukammal tozaligi","titleEnd":"","subtitle":"Toshkentda professional mebel kimyoviy tozalash, gilam yuvish va kvartira tozalash. Karcher jihozlari va xavfsiz eko vositalardan foydalanamiz.","cta":"Tozalashni buyurtma qiling","ctaSecondary":"Narxni bilish","stat1Value":"1000+","stat1Label":"Mamnun mijozlar","stat2Value":"5+","stat2Label":"Yillik tajriba","stat3Value":"99%","stat3Label":"Bizni tavsiya qiladi"},"services":{"label":"Xizmatlarimiz","title":"Klining xizmatlarining to'liq spektri","description":"Uy va biznes uchun keng turdagi tozalash xizmatlarini taklif etamiz","allBtn":"Barcha xizmatlar","detailBtn":"Batafsil","pageTitle":"Toshkentda klining xizmatlari","pageSubtitle":"Xizmatlar","pageDesc":"Uyingiz va biznesingiz uchun keng turdagi klining xizmatlari","ctaTitle":"Kerakli xizmatni topa olmadingizmi?","ctaDesc":"Biz bilan bog'laning va sizga individual yechim topib beramiz","ctaBtn":"Biz bilan bog'laning","cats":{"all":"Barchasi","rooms":"Xonalar","special":"Maxsus","facades":"Fasadlar va tashqi ko'rinish"},"includes":"Nimalar kiradi","orderBtn":"Xizmatni buyurtma qiling","detailPageBtn":"Xizmat haqida batafsil","leaveRequest":"Ariza qoldirish","backBtn":"Barcha xizmatlarga qaytish","aboutService":"Xizmat haqida","startingPrice":"Boshlang'ich narx"},"promotions":{"label":"Aksiyalar","title":"Maxsus takliflar va aksiyalar","description":"Maksimal foyda uchun maxsus takliflarimizdan foydalaning"},"advantages":{"label":"Ustunliklar","title":"Nima uchun bizni tanlashadi","description":"Biz shunchaki tozalamaymiz — tozalik va qulaylik muhitini yaratamiz","items":[{"title":"Sifat","desc":"Mutaxassislarimiz benuqsur natijaga erishish uchun zamonaviy usullar va ekologik toza vositalardan foydalanadi."},{"title":"Xavfsizlik","desc":"Siz va yaqinlaringiz sog'lig'ini qadrlaymiz. Shuning uchun faqat xavfsiz kimyoviy komponentlardan foydalanamiz."},{"title":"Individual yondashuv","desc":"Har bir mijoz bilan individual ishlayamiz, barcha istaklar va talablarni hisobga olamiz."},{"title":"Tezkorlik","desc":"Vaqtingizni qadrlaymiz. Ishlarni tez va samarali bajaramiz."},{"title":"Narxlar","desc":"Sifatimiz hammabop. Raqobatbardosh narxlar va doimiy mijozlar uchun chegirmalar taklif etamiz."},{"title":"Qulaylik","desc":"Qulay buyurtma tizimi, moslashuvchan jadval va mebel/gilamlarni yetkazib berish mavjud."}]},"howItWorks":{"label":"Qanday ishlayamiz","title":"Jarayonimiz — tozalikning kaliti","description":"Ideal kliningning 5 bosqichi","steps":[{"num":"01","title":"Xonani tayyorlash","desc":"Ob'ektni ko'zdan kechirish va maxsus kimyo tanlash"},{"num":"02","title":"Asosiy tozalash","desc":"Yuzalarni chuqur tozalash"},{"num":"03","title":"Dog'larni olib tashlash","desc":"Murakkab ifloslanishlar bilan nuqtali ish"},{"num":"04","title":"Dezinfektsiya","desc":"Tozalangan zonalarni qayta ishlash va quritish"},{"num":"05","title":"Sifatni tekshirish","desc":"Yakuniy ko'rikdan o'tkazish va mijozga topshirish"}]},"beforeAfter":{"label":"Natijalar","title":"Farq yaqqol ko'rinadi","description":"Ishlarimiz natijasini 'Oldin / Keyin' formatida ko'ring"},"faq":{"label":"Savol va javoblar","title":"Ko'p so'raladigan savollar (FAQ)","description":"Xizmatimiz haqida eng ko'p beriladigan savollarga javob beramiz","serviceFaqTitle":"FAQ —","serviceFaqDesc":"Bu xizmat haqida eng ko'p beriladigan savollarga javoblar","items":[{"question":"Ariza topshirilgandan so'ng brigada qancha vaqtda keladi?","answer":"O'rtacha Toshkentning istalgan tumaniga 2–4 soat ichida yetib boramiz. Bosh tozalash uchun 1–2 kun oldin buyurtma qilish tavsiya etiladi."},{"question":"Toshkent viloyatida (Chirchiq, Yangiyo'l, Qibray) xizmat ko'rsatasizmi?","answer":"Ha, shahardan tashqarida ham xizmat ko'rsatamiz. Shahardan 10 km gacha bepul chiqish, undan narigi ish hajmiga qarab kelishiladi."},{"question":"Tozalash paytida uyda bo'lishim kerakmi?","answer":"Shart emas. Ko'p mijozlarimiz kalitlarini berib, o'z ishlari bilan shug'ullanadi. Biz buyumlarning saqlanishi uchun to'liq moddiy javobgarlik olamiz."},{"question":"Tozalash vositalari bolalar va hayvonlar uchun xavfsizmi?","answer":"Ha, faqat gipoallergen, sertifikatlangan eko-vositalardan foydalanamiz, ular sog'liq uchun mutlaqo xavfsiz."},{"question":"Xizmatlarni qanday to'lash mumkin (Payme, Click, naqd)?","answer":"Naqd pul, terminal, Click va Payme orqali to'lash mumkin. Yuridik shaxslar uchun bank o'tkazmasi ham qabul qilinadi."},{"question":"Tozalash sifati yoqmasa nima bo'ladi?","answer":"Natijaga erishguncha ishlaymiz. 24 soat ichida kamchilik topilsa, bepul tuzatib beramiz yoki qisman pul qaytaramiz."},{"question":"Kimyoviy tozalashdan keyin mebel qancha qurishadi?","answer":"Odatda iliq va shamollatilgan xonada 4-6 soatda to'liq qurishadi. Namlikni so'rish uchun professional jihozdan foydalanamiz."}]},"pricing":{"label":"Narxlar ro'yxati","title":"Klining uchun shaffof narxlar","description":"Yashirin to'lovsiz xizmatlarimiz narxlari","pageTitle":"Toshkentda klining narxlari","pageSubtitle":"Narxlar ro'yxati","pageDesc":"Barcha klining xizmat turlari uchun shaffof narxlar","orderBtn":"Narxni hisoblash","note":"* Aniq narx ish hajmini baholashdan keyin hisoblanadi. Menejer chiqishi — bepul.","ctaTitle":"Aniq narx hisob-kitobini oling","ctaDesc":"Ariza qoldiring, menejerimiz 15 daqiqa ichida siz bilan bog'lanadi","ctaBtn":"Hisob-kitob buyurtma qilish"},"reviews":{"label":"Sharhlar","title":"Mijozlar nima deydi","description":"1000 dan ortiq mamnun mijoz GrandCleanga ishonadi","pageTitle":"Mijozlar sharhlari","pageSubtitle":"Sharhlar","pageDesc":"Mijozlarimizning xizmatlar sifati haqidagi fikrlari","ctaTitle":"Bizning mijozimiz bo'ldingizmi?","ctaDesc":"Tajribangizni Google'da ulashing — bu bizga yaxshilanishga yordam beradi"},"about":{"label":"Kompaniya haqida","title":"GrandClean — tozalikdagi ishonchli hamkoringiz","pageTitle":"Kompaniya haqida","pageSubtitle":"Biz haqimizda","pageDesc":"GrandClean jamoasi va qadriyatlarimiz haqida ko'proq bilib oling","story":"Kompaniya tarixi","storyText":"GrandClean 2019 yilda klining nafaqat toza, balki xavfsiz, ekologik va qalbdan bajarilishi kerak deb ishongan ishqibozlar jamoasi tomonidan tashkil etilgan. 5 yil ichida kichik brigadadan Toshkentning yetakchi klining kompaniyasiga aylandik.","mission":"Bizning vazifamiz","missionText":"Hayot va ish uchun ideal toza muhit yaratish — faqat xavfsiz materiallar va ilg'or texnologiyalardan foydalangan holda, shu bilan birga xizmatni Toshkentdagi har bir oila uchun accessible qilish.","team":"Jamoamiz"},"contact":{"label":"Aloqa","title":"Biz bilan bog'laning","pageTitle":"Toshkentdagi GrandClean kontaktlari","h1":"Toshkentdagi GrandClean kontaktlari","pageSubtitle":"Aloqa","pageDesc":"Bizga qo'ng'iroq qiling yoki ariza qoldiring — 15 daqiqa ichida qayta bog'lanamiz","subtitle":"Ariza qoldiring, 15 daqiqa ichida qayta bog'lanamiz","infoTitle":"Aloqa ma'lumotlari","phone":"Telefon","email":"Email","address":"Manzil","workHours":"Ish vaqti","workHoursValue":"Du-Ya: 08:00 — 22:00","addressValue":"Toshkent, Juraeva ko'chasi, 48","serviceOptions":["Kvartira tozalash","Ofis tozalash","Bosh tozalash","Ta'mirdan keyingi tozalash","Mebel kimyoviy tozalash","Oyna yuvish","Fasad yuvish","Bruchka tozalash","Dezinfeksiya","Parda, ko'rpa va kurpachalarni tozalash","Bolalar aravachalarini tozalash"],"urgent":"Shoshilinch tozalash kerakmi?","urgentDesc":"Bizga qo'ng'iroq qiling, 2 soat ichida yetib boramiz","callNow":"Hozir qo'ng'iroq qiling","formTitle":"Tozalashni buyurtma qiling","formDesc":"Shaklni to'ldiring, individual taklif tayyorlaymiz","formName":"Ismingiz","formNamePlaceholder":"Sizga qanday murojaat qilaylik?","formPhone":"Telefon","formPhonePlaceholder":"+998-XX-XXX-XX-XX","formService":"Xizmat turi","formServiceDefault":"Xizmatni tanlang","formMessage":"Xabar","formMessagePlaceholder":"Xonangiz va xohishlaringiz haqida aytib bering...","formSubmit":"Ariza yuborish","formSuccess":"Ariza yuborildi! 15 daqiqa ichida qayta bog'lanamiz."},"geography":{"label":"Qamrov hududi","title":"Butun Toshkent bo'ylab ishlaymiz","description":"Shaharning barcha tumanlariga va Toshkent viloyatiga chiqamiz"},"cta":{"label":"Tozalikka tayyormisiz?","title":"Hoziroq tozalashni buyurtma qiling","desc":"Birinchi tozalash 20% chegirma bilan. Ariza qoldiring, 15 daqiqa ichida qayta bog'lanamiz.","btn":"Tozalashni buyurtma qiling"},"footer":{"desc":"Toshkentda professional klining kompaniyasi. Kvartira, uy va ofislarni sifatli tozalash, bosh tozalash, ta'mirdan keyin tozalash, mebel kimyoviy tozalash va oyna yuvish.","nav":"Navigatsiya","services":"Xizmatlar","contacts":"Aloqa","copyright":"Barcha huquqlar himoyalangan.","tagline":"Toshkentda professional klining"},"notFound":{"title":"Sahifa topilmadi","desc":"Siz qidirayotgan sahifa mavjud emas yoki ko'chirilgan.","btn":"Bosh sahifaga"}}}],["$","main",null,{"id":"main-content","children":["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","$0:f:0:1:2:children:0","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L4",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":